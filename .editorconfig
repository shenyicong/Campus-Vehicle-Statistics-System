root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,md,cff}]
indent_size = 2

[*.{sh,bash}]
indent_size = 2

[Makefile]
indent_style = tab

[*.{png,jpg,jpeg,webp,gif,xlsx,onnx,pt,pth,mp4}]
trim_trailing_whitespace = false
insert_final_newline = false
